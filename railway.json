{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/meta",
    "healthcheckTimeout": 90,
    "healthcheckInterval": 30
  },
  "volumes": [
    {
      "name": "treg-data",
      "mountPath": "/app/data"
    }
  ]
}
